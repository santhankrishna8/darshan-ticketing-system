{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "registrationApp": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/registration-app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/assets",
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "ocr"
              },
              {
                "glob": "tesseract-core*-lstm.wasm.js",
                "input": "node_modules/tesseract.js-core",
                "output": "ocr/core"
              },
              {
                "glob": "eng.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/eng/4.0.0_best_int",
                "output": "ocr/lang"
              },
              {
                "glob": "zxing_reader.wasm",
                "input": "node_modules/zxing-wasm/dist/reader",
                "output": "ocr"
              }
            ],
            "styles": [
              "node_modules/@fontsource/geist-sans/latin-400.css",
              "node_modules/@fontsource/geist-sans/latin-500.css",
              "node_modules/@fontsource/geist-sans/latin-600.css",
              "node_modules/@fontsource/geist-mono/latin-400.css",
              "node_modules/@fontsource/noto-sans-telugu/telugu-400.css",
              "node_modules/@fontsource/noto-sans-telugu/telugu-500.css",
              "node_modules/@fontsource/noto-sans-telugu/telugu-600.css",
              "src/styles.css"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "xlsx",
              "tesseract.js",
              "regenerator-runtime",
              "html2canvas",
              "canvg",
              "core-js",
              "rgbcolor",
              "raf",
              "dompurify"
            ],
            "loader": {
              ".svg": "text"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "emulator": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.emulator.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "registrationApp:build:production"
            },
            "development": {
              "buildTarget": "registrationApp:build:development"
            },
            "emulator": {
              "buildTarget": "registrationApp:build:emulator"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/assets",
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "ocr"
              },
              {
                "glob": "tesseract-core*-lstm.wasm.js",
                "input": "node_modules/tesseract.js-core",
                "output": "ocr/core"
              },
              {
                "glob": "eng.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/eng/4.0.0_best_int",
                "output": "ocr/lang"
              },
              {
                "glob": "zxing_reader.wasm",
                "input": "node_modules/zxing-wasm/dist/reader",
                "output": "ocr"
              }
            ],
            "styles": [
              "node_modules/@fontsource/geist-sans/latin-400.css",
              "node_modules/@fontsource/geist-sans/latin-500.css",
              "node_modules/@fontsource/geist-sans/latin-600.css",
              "node_modules/@fontsource/geist-mono/latin-400.css",
              "node_modules/@fontsource/noto-sans-telugu/telugu-400.css",
              "node_modules/@fontsource/noto-sans-telugu/telugu-500.css",
              "node_modules/@fontsource/noto-sans-telugu/telugu-600.css",
              "src/styles.css"
            ],
            "scripts": [],
            "loader": {
              ".svg": "text"
            }
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false
  }
}