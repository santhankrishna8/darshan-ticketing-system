    "@angular/core": "^20.3.32",
    "@angular/forms": "^20.3.32",
    "@angular/platform-browser": "^20.3.32",
    "@angular/platform-browser-dynamic": "^20.3.32",
    "@angular/router": "^20.3.32",
    "@angular/service-worker": "^20.3.32",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vercel/analytics": "^1.5.0",
    "fflate": "^0.8.3",
    "firebase": "^12.1.0",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
