    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jasmine": "~5.1.0",
    "firebase-tools": "^15.32.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
