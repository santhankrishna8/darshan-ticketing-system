{
  "name": "registration-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:emulators": "firebase emulators:exec --only firestore,auth --ui \"ng serve --configuration emulator\"",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless",
    "test:rules": "firebase emulators:exec --project demo-darshan --only firestore \"node --test tests/firestore.rules.test.mjs\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.32",
    "@angular/common": "^20.3.32",
