{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/assets/**", "/media/**", "/*.(svg|png|jpg|woff|woff2|ttf)"]
      }
    },
    {
      "name": "scanner",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/ocr/**"]
      }
    }
  ]
}
